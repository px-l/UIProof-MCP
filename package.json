{
  "name": "uiproof-mcp",
  "version": "0.1.0",
  "description": "Deterministic visual acceptance with CLI, evidence and MCP",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "uiproof": "dist/cli.js",
    "uiproof-mcp": "dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "demo": "tsx examples/demo.ts",
    "mcp": "node dist/mcp.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pngjs": "6.0.5",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
